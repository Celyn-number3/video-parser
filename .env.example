# Video Parser 环境配置

# ==================== Qwen3-VL API 配置 ====================
# API 基础地址（ModelScope）
QWEN_API_BASE_URL=https://api-inference.modelscope.cn/v1

# API 密钥（从 ModelScope 获取）
# 获取地址：https://modelscope.cn/my/myaccesstoken
QWEN_API_KEY=your-modelscope-api-key-here

# 模型 ID
QWEN_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct

# 视频分析时提取的帧数（默认6-8帧）
MAX_FRAMES=6

# 本机 Whisper 环境（已有模型与 CUDA 运行时，不自动安装）

# B站字幕工具与可选校验脚本（按本机位置设置，不包含登录态）

# 字幕与 Whisper 默认使用项目内集成模块，无需配置外部工具目录。

# Optional Kuaishou login Cookie. Keep the real value in .env only.
KUAISHOU_COOKIE=
